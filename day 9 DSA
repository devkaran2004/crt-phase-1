//TRAVERSAL AND MEMORY
#include <iostream>
using namespace std;

 void traveral(int arr[],int size){
    for(int i=0;i<size;i++){
        cout<<&arr[i]<<" "<<endl; ;
        cout<<arr[i]<<" " ;
    }
}

int main() {
    int arr[]={1,2,3,4,5};
    traveral(arr,5);
    return 0;
}



//LINEAR SEARCH//
#include <iostream>
using namespace std;
 
int Lserach(int arr[], int size, int target){
    for(int i=0;i<size;i++){
        if(arr[i]==target){
            return i;
        }
    }
    return -1;
}

int main() {
    int arr[]={10,20,30,40,50};
    cout<<Lserach(arr,5,20);
    return 0;
}

//INSERTION
#include <iostream>
using namespace std;

void print(int arr[],int size){
for(int i=0;i<size;i++){
    cout<<arr[i]<<" ";
}
cout<<endl;
}

void insert(int arr[],int &size,int idx,int value){
    for(int i=size;i>=idx;i--){
        arr[i]=arr[i-1];
    }
    arr[idx]=value;
    size++;
}

int main() {
    int arr[]={10,20,30,40,50};
    int size=5;
    insert(arr,size,2,25);
    print(arr,size);
    return 0;
}



