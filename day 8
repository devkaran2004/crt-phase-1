//OOPS
//INHERITANCE-1)SINGLE

#include <iostream>
using namespace std;
 class Vehicle {
public :
void start(){
    cout<<"vehicle start"<<endl;
}

};
class Car : public Vehicle{
    public :
 void drive(){
    cout<<"car running...";
 }
};
int main(){
Car c;
c.start();
c.drive();
}


